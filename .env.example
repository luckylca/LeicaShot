# Directory containing locally authorized ONNX assets. Model files stay out of Git.
LAIKA_MODEL_DIR=./models

# Optional SAM, ViTMatte, and GAIC paths are inside the mounted model directory.
# Leave these empty to disable those optional API features.
LAIKA_SAM_MODEL_DIR=
LAIKA_VITMATTE_MODEL=
LAIKA_GAIC_MODEL=

# The UI and API bind to loopback by default. Set a host address deliberately
# only when another machine must connect through a separately secured network.
LAIKA_BIND_ADDRESS=127.0.0.1
LAIKA_WEB_PORT=8080
LAIKA_API_PORT=8000

# Low-memory CPU defaults; increase only after checking host capacity.
LAIKA_MEMORY_LIMIT=3g
LAIKA_CPU_LIMIT=2
LAIKA_API_STRATEGY=low-memory
LAIKA_API_THREADS=1
LAIKA_API_MAX_WORKERS=1
LAIKA_API_QUEUE_CAPACITY=1
LAIKA_API_MAX_UPLOAD_BYTES=52428800
LAIKA_API_MAX_PIXELS=40000000
LAIKA_API_MAX_NETWORK_PIXELS=4000000
LAIKA_API_MAX_STORAGE_BYTES=10737418240
LAIKA_API_RESULT_TTL_SECONDS=21600
LAIKA_API_CORS_ORIGINS=
